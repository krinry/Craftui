export component CraftpadStudio {
    in-out property <string> selected_template: "Counter";
    in-out property <string> source_code: "";
    in-out property <string> status_text: "Ready — 0 errors";
    in-out property <string> active_tab: "preview";
    callback on_run();
    callback on_format();
    callback on_select_template(string);

    Container {
        width: 100%;
        height: 100%;
        background: #0b0f19;
        padding: 16px;

        Column {
            gap: 14px;
            width: 100%;
            height: 100%;
            align: "stretch";

            // Header Toolbar
            Container {
                background: #111827;
                padding: 12px;
                border_radius: 8px;

                Row {
                    justify: "space_between";
                    align: "center";

                    Row {
                        gap: 16px;
                        align: "center";

                        Text {
                            text: "Craftpad";
                            font_size: 20px;
                            font_weight: 700.0;
                            color: #38bdf8;
                        }

                        Text {
                            text: "• In-Browser Playground";
                            font_size: 14px;
                            color: #94a3b8;
                        }
                    }

                    Row {
                        gap: 10px;
                        align: "center";

                        Button {
                            text: "Counter";
                            background: #1e293b;
                            foreground: #f8fafc;
                            padding: 8px;
                            border_radius: 6px;
                            on_tap => {
                                selected_template = "Counter";
                                on_select_template("Counter");
                            }
                        }

                        Button {
                            text: "Login";
                            background: #1e293b;
                            foreground: #f8fafc;
                            padding: 8px;
                            border_radius: 6px;
                            on_tap => {
                                selected_template = "Login";
                                on_select_template("Login");
                            }
                        }

                        Button {
                            text: "Settings";
                            background: #1e293b;
                            foreground: #f8fafc;
                            padding: 8px;
                            border_radius: 6px;
                            on_tap => {
                                selected_template = "Settings";
                                on_select_template("Settings");
                            }
                        }

                        Button {
                            text: "▷ Run";
                            background: #0284c7;
                            foreground: #ffffff;
                            padding: 8px;
                            border_radius: 6px;
                            on_tap => {
                                on_run();
                            }
                        }

                        Button {
                            text: "Format";
                            background: #334155;
                            foreground: #f8fafc;
                            padding: 8px;
                            border_radius: 6px;
                            on_tap => {
                                on_format();
                            }
                        }
                    }
                }
            }

            // Main Workspace (Split left/right)
            Row {
                gap: 14px;
                width: 100%;
                flex_grow: 1.0;
                align: "stretch";

                // Left: Code Editor Pane
                Container {
                    width: 50%;
                    background: #111827;
                    padding: 14px;
                    border_radius: 8px;

                    Column {
                        gap: 8px;
                        width: 100%;
                        height: 100%;
                        align: "stretch";

                        Row {
                            justify: "space_between";
                            align: "center";

                            Text {
                                text: "DSL Source (.cui)";
                                font_size: 14px;
                                font_weight: 700.0;
                                color: #cbd5e1;
                            }

                            Text {
                                text: selected_template;
                                font_size: 12px;
                                color: #38bdf8;
                            }
                        }

                        TextInput {
                            value <=> source_code;
                            multiline: true;
                            background: #090d16;
                            color: #f8fafc;
                            font_size: 13px;
                            padding: 12px;
                            border_radius: 6px;
                            flex_grow: 1.0;
                        }
                    }
                }

                // Right: Live Preview & Canvas Pane
                Container {
                    width: 50%;
                    background: #111827;
                    padding: 14px;
                    border_radius: 8px;

                    Column {
                        gap: 8px;
                        width: 100%;
                        height: 100%;
                        align: "stretch";

                        Row {
                            justify: "space_between";
                            align: "center";

                            Text {
                                text: "Live Canvas Preview";
                                font_size: 14px;
                                font_weight: 700.0;
                                color: #cbd5e1;
                            }

                            Text {
                                text: "60 FPS • GPU SDF";
                                font_size: 12px;
                                color: #10b981;
                            }
                        }

                        Container {
                            background: #090d16;
                            border_radius: 6px;
                            padding: 16px;
                            flex_grow: 1.0;

                            Column {
                                gap: 12px;
                                align: "center";
                                justify: "center";

                                Text {
                                    text: "Rendering: " + selected_template;
                                    font_size: 18px;
                                    font_weight: 700.0;
                                    color: #f1f5f9;
                                }

                                Text {
                                    text: "Interactive WASM canvas mounts here";
                                    font_size: 13px;
                                    color: #64748b;
                                }
                            }
                        }
                    }
                }
            }

            // Bottom Status Console
            Container {
                background: #111827;
                padding: 10px;
                border_radius: 6px;

                Row {
                    justify: "space_between";
                    align: "center";

                    Text {
                        text: status_text;
                        font_size: 13px;
                        color: #a7f3d0;
                    }

                    Text {
                        text: "CraftUI 0.1.0 • Pure Rust & WebAssembly";
                        font_size: 12px;
                        color: #64748b;
                    }
                }
            }
        }
    }
}
